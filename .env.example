# Backend
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/univault
JWT_SECRET=change_this_jwt_secret
JWT_EXPIRES_IN=7d
PORT=4000
FRONTEND_URL=http://localhost:5173
RESET_TOKEN_EXPIRES_MINUTES=60

# SMTP (optional for local dev; if missing, reset endpoint returns developmentResetUrl)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_user
SMTP_PASS=your_pass
SMTP_FROM=noreply@univault.local

# Frontend
VITE_API_URL=http://localhost:4000/api
